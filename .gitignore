# Node 22 project: build outputs, dependencies, and local-only files.
# Written for the git-forge entry; keep secrets and caches out of git.

# Dependency trees and build outputs
node_modules
dist/
build
out/
web_modules

# Logs and diagnostics
logs/
**/*.log
npm-debug.log
yarn-error.log
report.*.json

# Process files, coverage, and test artifacts
pids/
**/*.pid
coverage/
.nyc_output/
**/*.lcov

# Local environment and secrets (never commit these)
.env*
.env.local
.env.*.local

# Editor, OS, and tool caches
.DS_Store
Thumbs.db
.vscode
.idea
**/.cache
.npm/
.eslintcache/
.turbo/
.parcel-cache/

# Packaged archives
**/*.tgz
